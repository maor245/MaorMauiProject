<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MaorMauiProject.Test"
             Title="Test">
    
    <StackLayout
        BackgroundColor="Gray"
        Orientation="Vertical">
        

        <Label
            Background="Blue"
            TextColor="White"
            Text="Hello MAUI"
            FontSize="20" />

        <Label
            WidthRequest="150"
            Background="Blue"
            TextColor="White"
            Text="Hello MAUI"
            FontSize="20" />

        <Grid>
            <Label
                Grid.Row="1"
                Background="Green"
                TextColor="White"
                Text="GRID3"
                FontSize="20" />
        </Grid>
        
        <Button
               Clicked=""
               WidthRequest="100"
               HeightRequest="100"
               CornerRadius="50"
               Text="Start">
            <Button.Shadow>
                <Shadow
               Brush="Black"
               Opacity="0.5"
               Offset="20,20"></Shadow>
            </Button.Shadow>
        </Button>

        <Border 
               Stroke="#C49B33"
               StrokeThickness="4"
               Background="Transparent"
               HorizontalOptions="Center">
        </Border>


    </StackLayout>
</ContentPage>
    
 
    